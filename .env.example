# == AidSec Environment Configuration ==
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git!

# == Base URL ==
BASE_URL=https://aidsec.ch

# == Stripe (Live Keys) ==
STRIPE_SECRET_KEY=<replace-with-stripe-secret-key>
STRIPE_PUBLIC_KEY=<replace-with-stripe-public-key>
STRIPE_WEBHOOK_SECRET=<replace-with-stripe-webhook-secret>
STRIPE_PRICE_RAPID=<replace-with-stripe-price-id>
STRIPE_PRICE_HAERTUNG=<replace-with-stripe-price-id>
STRIPE_PRICE_MANDAT_MONTHLY=<replace-with-stripe-price-id>
STRIPE_PRICE_MANDAT_YEARLY=<replace-with-stripe-price-id>

# == Upstash Redis ==
UPSTASH_REDIS_REST_URL=https://workable-kingfish-106621.upstash.io
UPSTASH_REDIS_REST_TOKEN=<replace-with-upstash-token>
KV_REST_API_URL=https://workable-kingfish-106621.upstash.io
KV_REST_API_TOKEN=<replace-with-kv-token>
KV_REST_API_READ_ONLY_TOKEN=<replace-with-ro-token>
KV_URL=rediss://default:<token>@workable-kingfish-106621.upstash.io:6379
REDIS_URL=rediss://default:<token>@workable-kingfish-106621.upstash.io:6379

# == Cloudflare R2 ==
R2_ACCOUNT_ID=9a0e1ab190099be9b4be61dcadd9f16c
R2_BUCKET=aidsec-reports
R2_ACCESS_KEY_ID=<replace-with-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<replace-with-r2-secret-access-key>

# == Cloudflare API ==
CF_API_TOKEN=<replace-with-cf-api-token>
CF_ACCOUNT_ID=9a0e1ab190099be9b4be61dcadd9f16c

# == Email Provider ==
# EMAIL_PROVIDER=auto uses Brevo when BREVO_API_KEY is set, otherwise SMTP.
# Use EMAIL_PROVIDER=smtp for Microsoft 365 / Office 365 SMTP.
EMAIL_PROVIDER=auto
BREVO_API_KEY=<replace-with-brevo-api-key-or-leave-empty-for-smtp>
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<replace-with-mailbox-email>
SMTP_PASS=<replace-with-smtp-password-or-app-password>
EMAIL_FROM=AidSec <aid.destani@aidsec.ch>
ONBOARDING_FROM_EMAIL=AidSec <aid.destani@aidsec.ch>
ONBOARDING_TO_EMAIL=aid.destani@aidsec.ch

# == Plugin Webhook ==
PLUGIN_TOKEN_VERSION=1
PLUGIN_MAKE_WEBHOOK_URL=<replace-with-webhook-url>

# == Security ==
INTERNAL_API_SECRET=<generate-random-secret>
INTERNAL_WORKFLOW_SECRET=<generate-random-secret>
ORDER_TOKEN_SECRET=<generate-random-secret>
ALLOWED_ORIGIN=https://aidsec.ch
CRON_SECRET=<generate-random-secret>

# == hCaptcha ==
HCAPTCHA_SITE_KEY=69ae5b0c-a530-46c2-b978-e1a6f72615c8
HCAPTCHA_SECRET=<replace-with-hcaptcha-secret>

# == Harpa AI ==
HARPA_AI_KEY=<replace-with-harpa-ai-key>
