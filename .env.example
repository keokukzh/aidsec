# == AidSec Environment Configuration ==
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git!

# == Base URL ==
BASE_URL=https://aidsec.ch

# == Stripe (Live Keys) ==
# Already configured: STRIPE_SECRET_KEY, STRIPE_PUBLIC_KEY, STRIPE_WEBHOOK_SECRET
# Already configured: STRIPE_PRICE_RAPID, STRIPE_PRICE_HAERTUNG, STRIPE_PRICE_MANDAT_MONTHLY, STRIPE_PRICE_MANDAT_YEARLY
STRIPE_WEBHOOK_SECRET=<replace-with-stripe-webhook-secret>
STRIPE_DASHBOARD_URL=https://dashboard.stripe.com

# == Upstash Redis ==
# Already configured: UPSTASH_REDIS_REST_URL, UPSTASH_REDIS_REST_TOKEN
# Already configured: KV_REST_API_URL, KV_REST_API_TOKEN, KV_REST_API_READ_ONLY_TOKEN
# Already configured: KV_URL, REDIS_URL
UPSTASH_REDIS_REST_TOKEN=<replace-with-upstash-token>

# == Airtable CRM ==
AIRTABLE_API_KEY=<replace-with-airtable-api-key>
AIRTABLE_BASE_ID=<replace-with-airtable-base-id>

# == Cloudflare R2 ==
# Already configured: R2_ACCOUNT_ID, R2_BUCKET
# Already configured: R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY
R2_ACCESS_KEY_ID=<replace-with-r2-access-key-id>
R2_SECRET_ACCESS_KEY=<replace-with-r2-secret-access-key>

# == Cloudflare API ==
# Already configured: CF_API_TOKEN, CF_ACCOUNT_ID
CF_API_TOKEN=<replace-with-cf-api-token>

# == Email Provider ==
# EMAIL_PROVIDER=auto uses Brevo when BREVO_API_KEY is set, otherwise SMTP.
# Use EMAIL_PROVIDER=smtp for Microsoft 365 / Office 365 SMTP.
# Already configured: EMAIL_PROVIDER, BREVO_API_KEY, SMTP_HOST, SMTP_PORT, SMTP_SECURE, SMTP_USER, SMTP_PASS
# Already configured: EMAIL_FROM, ONBOARDING_FROM_EMAIL, ONBOARDING_TO_EMAIL
EMAIL_PROVIDER=auto
BREVO_API_KEY=<replace-with-brevo-api-key-or-leave-empty-for-smtp>
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<replace-with-mailbox-email>
SMTP_PASS=<replace-with-smtp-password-or-app-password>
EMAIL_FROM=AidSec <aid.destani@aidsec.ch>
ONBOARDING_FROM_EMAIL=AidSec <aid.destani@aidsec.ch>
ONBOARDING_TO_EMAIL=aid.destani@aidsec.ch

# == Plugin Webhook ==
# Already configured: PLUGIN_TOKEN_VERSION, PLUGIN_MAKE_WEBHOOK_URL
PLUGIN_TOKEN_VERSION=1
PLUGIN_MAKE_WEBHOOK_URL=<replace-with-webhook-url>

# == Security ==
# Already configured: INTERNAL_API_SECRET, INTERNAL_WORKFLOW_SECRET, ORDER_TOKEN_SECRET, CRON_SECRET
# Already configured: ALLOWED_ORIGIN
INTERNAL_API_SECRET=<generate-random-secret>
ORDER_TOKEN_SECRET=<generate-random-secret>
ALLOWED_ORIGIN=https://aidsec.ch

# == hCaptcha ==
# Already configured: HCAPTCHA_SITE_KEY, HCAPTCHA_SECRET
HCAPTCHA_SITE_KEY=69ae5b0c-a530-46c2-b978-e1a6f72615c8
HCAPTCHA_SECRET=<replace-with-hcaptcha-secret>

# == AI Gateway ==
# Already configured: AI_GATEWAY_API_KEY
AI_GATEWAY_API_KEY=<replace-with-ai-gateway-api-key>

# == Harpa AI ==
# Already configured: HARPA_AI_KEY
HARPA_AI_KEY=<replace-with-harpa-ai-key>
