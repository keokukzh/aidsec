# AidSec.ch — Environment Variables
# Copy to .env.local for local development

# ── Stripe Checkout ──────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_RAPID=price_...          # CHF 390 one-time
STRIPE_PRICE_HAERTUNG=price_...        # CHF 790 one-time
STRIPE_PRICE_MANDAT_MONTHLY=price_...  # CHF 89/month subscription
STRIPE_PRICE_MANDAT_YEARLY=price_...   # CHF 1'068/year subscription

# ── Magic-Link Auth (Order Status) ───────────────────────────────
ORDER_TOKEN_SECRET=generate-a-32-char-random-secret-here

# ── Plugin Token Redesign ───────────────────────────────────────
# Plugin install secrets are generated per order/license and stored in Upstash.
PLUGIN_TOKEN_VERSION=1
PLUGIN_MAKE_WEBHOOK_URL=https://hook.eu1.make.com/h6sbfnewo9cf03j3lk8umcyxnlkabk8c

# ── Object Storage (Cloudflare R2) ──────────────────────────────
# Option A: Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=aidsec-reports

# Option B: AWS S3
# AWS_ACCESS_KEY_ID=your-aws-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret
# AWS_REGION=eu-central-1
# S3_BUCKET=aidsec-reports

# ── Monitoring ──────────────────────────────────────────────────
CRON_SECRET=generate-a-cron-secret-here
AUTH_DOMAIN=aidsec.ch

# ── Onboarding / SMTP ───────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
ONBOARDING_TO_EMAIL=aid.destani@aidsec.ch
ONBOARDING_FROM_EMAIL=noreply@aidsec.ch

# ── Rate Limiting (Upstash Redis) ───────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Internal API
INTERNAL_API_SECRET=generate-a-32-char-random-secret-here

# ── General ─────────────────────────────────────────────────────
NODE_ENV=development
BASE_URL=https://aidsec.ch
ALLOWED_ORIGIN=https://aidsec.ch
VERCEL_URL=aidsec.ch.vercel.app
