{
  "name": "aidsec.ch",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npm run prepare-fonts && vite build",
    "fill": "node scripts/fill-placeholders.js",
    "prepare-fonts": "node scripts/prepare-fonts.js",
    "verify-headers": "node scripts/verify-security-headers.js",
    "test": "node --test tests/*.test.js",
    "lint": "eslint \"js/**/*.{js,jsx}\" \"api/**/*.js\" \"tests/*.js\"",
    "format": "prettier --write js/*.js js/*.jsx",
    "video:prepare": "node scripts/prepare-remotion-assets.mjs",
    "video:studio": "npm run video:prepare && remotion studio remotion/Root.jsx --public-dir=remotion/public",
    "video:render:all": "node scripts/render-aidsec-videos.mjs",
    "video:still:proof": "npm run video:prepare && remotion still remotion/Root.jsx AidSecProofCenterWide remotion/renders/aidsec-proof-center-frame.png --frame=150 --public-dir=remotion/public",
    "video:check": "node scripts/check-videos.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@fontsource/instrument-serif": "^5.2.8",
    "@fontsource/plus-jakarta-sans": "^5.2.8",
    "motion": "^12.34.0",
    "nodemailer": "^8.0.1",
    "puppeteer": "^24.40.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.467",
    "@remotion/fonts": "4.0.467",
    "@vitejs/plugin-react": "^5.1.4",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.8.1",
    "remotion": "4.0.467",
    "sharp": "^0.34.5",
    "vite": "^7.3.1",
    "zod": "4.3.6"
  }
}
